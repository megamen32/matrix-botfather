[Unit]
Description=Private LAN proxy for the Klub control plane
Requires=klub-control-plane-lan.socket
After=klub-control-plane.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:8092
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes

[Install]
RequiredBy=klub-control-plane-lan.socket
